# iniciar.bat crea .env y genera claves locales si la base es nueva.
# Para inicio manual, copiar como .env y completar las claves. No publicarlas en Git.
APP_ENV=development
# APP_URL y FRONTEND_ORIGIN se deducen de APP_PORT en Compose.
# Solo definirlos si se necesita un dominio u origen especifico.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=imsj
DB_USERNAME=imsj
DB_PASSWORD=CAMBIAR_CLAVE_LOCAL
DB_ROOT_PASSWORD=CAMBIAR_CLAVE_ROOT_LOCAL
# Solo para crear la primera cuenta mediante scripts/crear_admin.php.
# No se ejecuta automáticamente ni modifica cuentas existentes.
INITIAL_ADMIN_CEDULA=
INITIAL_ADMIN_NOMBRE=
INITIAL_ADMIN_PASSWORD=

APP_PORT=8000
