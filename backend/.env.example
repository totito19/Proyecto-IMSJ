# Copiar como .env y completar los valores de la instalación. No publicarlo en Git.
APP_ENV=production
APP_BIND=0.0.0.0
APP_PORT=8000
# Sustituir 192.168.1.50 por la IP fija o el dominio del servidor.
APP_URL=http://192.168.1.50:8000
FRONTEND_ORIGIN=http://192.168.1.50:8000

# La aplicación utiliza db dentro de Docker Compose.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=imsj
DB_USERNAME=imsj
DB_PASSWORD=CAMBIAR_CLAVE_SEGURA
DB_ROOT_PASSWORD=CAMBIAR_CLAVE_ROOT_SEGURA
# Solo para crear la primera cuenta mediante scripts/crear_admin.php.
# No se ejecuta automáticamente ni modifica cuentas existentes.
INITIAL_ADMIN_CEDULA=
INITIAL_ADMIN_NOMBRE=
INITIAL_ADMIN_PASSWORD=
