# Apache sirve solo public/; las demás carpetas quedan fuera de DocumentRoot.
Options -Indexes
RewriteEngine On
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
# Evitar que la entrada vuelva a reescribirse durante el despacho de Apache.
RewriteRule ^index\.php$ - [L]
RewriteRule ^ index.php [QSA,END]
